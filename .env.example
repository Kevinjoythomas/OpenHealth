# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=openhealth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openhealth
# Full connection string used by services
DATABASE_URL=postgresql://openhealth:changeme@postgres:5432/openhealth

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=openhealth
RABBITMQ_PASS=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-generate-a-real-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Auth service ──────────────────────────────────────────────────────────────
BCRYPT_COST_FACTOR=12

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
# When running Ollama on the host machine outside Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=hf.co/kevinjoythomas/medical-loratuned-chatbot-GGUF
EMBED_MODEL=nomic-embed-text

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── S3 / Document storage (ingestion-worker) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=openhealth-docs
S3_REGION=us-east-1

# ── Service URLs (used by api-gateway) ───────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:5001
CHAT_SERVICE_URL=http://chat-orchestrator:5002
RETRIEVAL_SERVICE_URL=http://retrieval-service:5003
